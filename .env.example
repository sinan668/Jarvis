# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variable template for JARVIS AI Assistant
#
# USAGE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the keys that you have.
#   3. Variables you leave blank or omit will use built-in defaults.
#
# SECURITY:
#   • The .env file is listed in .gitignore — NEVER commit it to git.
#   • This .env.example file contains no real secrets and IS safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity ──────────────────────────────────────────────────────────────────
ASSISTANT_NAME=JARVIS
WAKE_WORD=jarvis

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Leave blank to run in offline / stub mode (no API needed right now).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Free Hugging Face model used for offline AI (Step 3)
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# ── Voice ──────────────────────────────────────────────────────────────────────
SPEECH_LANGUAGE=en-US
TTS_RATE=180          # words per minute (50 – 300 is a sensible range)
TTS_VOLUME=1.0        # 0.0 (silent) → 1.0 (full volume)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=jarvis.log   # Path to the log file (relative to project root)
