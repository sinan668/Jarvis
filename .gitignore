# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Files that must NOT be committed to version control
# ─────────────────────────────────────────────────────────────────────────────

# Secrets — NEVER commit these
.env

# Python cache and build artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env_backup

# Logs
*.log

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Data that may contain personal info
data/
